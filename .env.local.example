# ---------------------------------------------------------------------------
# BAMYON-IMS — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# NOTE ON ARCHITECTURE: this project intentionally uses ONLY the Firebase
# client (Web) SDK — there is no firebase-admin / service-account credential
# anywhere in this codebase. Firestore Security Rules (see firestore.rules)
# are the real authorization boundary, not server code. This matches the
# instruction: "no firebase service account thingie, everything is strictly
# firestore + auth."
# ---------------------------------------------------------------------------

# --- Firebase (public — safe to expose, protected by Security Rules) -------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Multi-tenant ------------------------------------------------------------
# The storeId this deployment serves. Every Firestore query/write is scoped
# to this value (see src/lib/tenant.ts). One Vercel project per merchant
# deployment is the simplest white-label model for phase 1-5.
NEXT_PUBLIC_STORE_ID=bamyon-demo-store

# --- Cloudinary (unsigned preset OR signed upload endpoint) ----------------
# The upload SIGNATURE must be generated by a server route using the
# Cloudinary API secret — never put the secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paystack ----------------------------------------------------------------
# Public key is safe on the client. Secret key must NEVER be prefixed
# NEXT_PUBLIC_ — it is only read inside app/api/* route handlers on the server.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Currency ------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY=NGN
